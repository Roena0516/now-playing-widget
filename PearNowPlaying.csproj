<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>PearNowPlaying</AssemblyName>
    <RootNamespace>PearNowPlaying</RootNamespace>
    <ApplicationIcon>assets\app.ico</ApplicationIcon>
    <!-- assembly attributes live in src/Program.cs -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="assets\fonts\PretendardJP-Regular.ttf" LogicalName="PretendardJP-Regular.ttf" />
    <EmbeddedResource Include="assets\fonts\PretendardJP-Medium.ttf" LogicalName="PretendardJP-Medium.ttf" />
    <EmbeddedResource Include="assets\fonts\PretendardJP-coverage.bin" LogicalName="PretendardJP-coverage.bin" />
  </ItemGroup>

</Project>
